{
  "buildCommand": "npm --prefix luminate-support-dashboard install && npm --prefix luminate-support-dashboard run build",
  "outputDirectory": "luminate-support-dashboard/dist",
  "framework": null,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "crons": [
    { "path": "/api/jitbit/stats?period=thisyear",                "schedule": "0 * * * *" },
    { "path": "/api/jitbit/stats?period=thisquarter",             "schedule": "15 * * * *" },
    { "path": "/api/jitbit/stats?period=thisyear&detail=true",    "schedule": "30 * * * *" },
    { "path": "/api/jitbit/stats?period=thisquarter&detail=true", "schedule": "45 * * * *" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
